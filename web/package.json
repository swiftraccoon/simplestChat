{
  "name": "simplestchat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.10.0",
    "npm": ">=12.2.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error .",
    "format:check": "prettier --check \"**/*.{ts,mts,cts,js,mjs,cjs,css,html,json,jsonc}\"",
    "format": "prettier --write \"**/*.{ts,mts,cts,js,mjs,cjs,css,html,json,jsonc}\"",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build": "npm run typecheck && vite build && npm run check:bundle",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "mediasoup-client": "3.25.3"
  },
  "packageManager": "npm@12.2.0"
}
