# Deny by default so local secrets, test output, editor state, and repository
# history cannot enter the build context. Add only inputs consumed by Dockerfile.
**
!Dockerfile
!.dockerignore
!Cargo.toml
!Cargo.lock
!build/
!build/pip-constraints.txt
!build/install-openssl.sh
!vendor/
!vendor/**
!src/
!src/*.rs
!src/auth/
!src/auth/*.rs
!src/media/
!src/media/*.rs
!src/room/
!src/room/*.rs
!src/signaling/
!src/signaling/*.rs
!migrations/
!migrations/*.sql
!load_tests/
!load_tests/*.rs
!load_tests/bin/
!load_tests/bin/*.rs
!load_tests/clients/
!load_tests/clients/*.rs
!web/
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/vite.config.ts
!web/index.html
!web/src/
!web/src/*.ts
!web/src/*.css
