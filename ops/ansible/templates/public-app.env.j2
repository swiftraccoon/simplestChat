# Managed private configuration; do not print Compose's resolved environment.
SIMPLESTCHAT_IMAGE={{ scpub_server_image }}
DATABASE_URL=postgres://simplestchat_app:{{ scpub_secrets.database_password }}@localhost/simplestchat?host=/run/simplestchat-postgres&sslmode=disable
JWT_SECRET={{ scpub_secrets.jwt_secret }}
METRICS_TOKEN={{ scpub_secrets.metrics_token }}
TRUSTED_PROXY_SECRET={{ scpub_secrets.proxy_secret }}
ALLOWED_ORIGINS=https://{{ scpub_domain }}
WEBAUTHN_RP_ID={{ scpub_domain }}
WEBAUTHN_ORIGIN=https://{{ scpub_domain }}
ANNOUNCE_IP={{ scpub_announce_ip }}
BIND_ADDR=0.0.0.0
PORT=3000
RUN_MIGRATIONS=false
REGISTRATION_ENABLED={{ 'true' if scpub_registration_enabled else 'false' }}
ALLOW_AD_HOC_ROOMS=false
# Sized from the host (group_vars/benchmark_hosts.yml explains the model; the
# inventory overrides any line). One media worker per app CPU, one UDP port per
# worker from 40000: open the range at the firewall.
MEDIA_WORKERS={{ scpub_media_workers }}
RTC_PORT_END={{ 40000 + (scpub_media_workers | int) - 1 }}
SIMPLESTCHAT_CPUS={{ scpub_app_cpus }}
SIMPLESTCHAT_MEMORY_LIMIT={{ scpub_app_memory_mib }}m
MAX_CONNECTIONS={{ scpub_max_connections }}
MAX_USERS=100
MAX_ROOMS={{ scpub_max_rooms }}
MAX_PERSISTED_ROOMS=100
# One webinar may fill the host (viewers spread over every worker); the
# all-publishing grid stops near 28 whatever the host (the per-viewer cap).
MAX_PARTICIPANTS_PER_ROOM={{ scpub_max_participants_per_room }}
# Past about 30 publishers the per-viewer cap starves every tile; webinars keep their viewers.
MAX_BROADCASTERS_PER_ROOM={{ scpub_max_broadcasters_per_room }}
RUST_LOG=simplestChat=info,mediasoup=warn
{% if scpub_turn_enabled | default(false) %}
TURN_URLS=turn:{{ scpub_domain }}:3478?transport=udp,turn:{{ scpub_domain }}:3478?transport=tcp,turns:{{ scpub_domain }}:5349?transport=tcp
TURN_SECRET={{ scpub_turn_secret }}
TURN_TTL=86400
{% endif %}
