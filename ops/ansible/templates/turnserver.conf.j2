# coturn 4.18.0: TLS 1.2 minimum; DTLS, CLI, RFC5780 and web admin default off.
listening-ip={{ scpub_announce_ip }}
relay-ip={{ scpub_announce_ip }}
listening-port=3478
tls-listening-port=5349
min-port={{ scpub_turn_relay_port_min }}
max-port={{ scpub_turn_relay_port_max }}
realm={{ scpub_domain }}
use-auth-secret
static-auth-secret={{ scpub_turn_secret }}
cert=/tls/current/certificate.pem
pkey=/tls/current/key.pem
userdb=/tmp/turndb
pidfile=/tmp/turnserver.pid
no-auth-pings
no-dynamic-ip-list
no-dynamic-realms
no-stun
no-tcp-relay
no-multicast-peers
denied-peer-ip=0.0.0.0-255.255.255.255
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
allowed-peer-ip={{ scpub_announce_ip }}
user-quota={{ scpub_turn_user_quota }}
total-quota={{ scpub_turn_total_quota }}
max-bps={{ scpub_turn_max_bps }}
bps-capacity={{ scpub_turn_bps_capacity }}
stale-nonce=600
relay-threads={{ scpub_turn_relay_threads }}
log-file=stdout
log-min-level=warning
{% if scpub_turn_metrics_enabled | default(false) %}
prometheus
prometheus-address=127.0.0.1
prometheus-port=9641
{% endif %}
