[Unit]
Description=Nightly logical backup of the public simplestChat database
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RuntimeDirectory=simplestchat-bench
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/bash /usr/local/libexec/simplestchat-public/backup-nightly.sh
UMask=0077
TimeoutStartSec=300
MemoryMax=256M
TasksMax=64
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/simplestchat-public/backups /run/simplestchat-bench
RestrictSUIDSGID=true
LockPersonality=true
