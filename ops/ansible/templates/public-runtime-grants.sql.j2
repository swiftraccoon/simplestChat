-- Run as postgres after the packaged migration ledger has been verified.
-- Keep this allowlist explicit: the runtime must never edit _sqlx_migrations.
\set ON_ERROR_STOP on
BEGIN;
GRANT SELECT, INSERT, UPDATE
  ON public.users
  TO simplestchat_app;
GRANT SELECT, INSERT, UPDATE, DELETE
  ON public.webauthn_credentials
  TO simplestchat_app;
GRANT SELECT, INSERT, UPDATE, DELETE
  ON public.sessions, public.rooms, public.room_roles,
     public.room_states, public.room_reports, public.moderation_events,
     public.invites, public.chat_messages, public.chat_inbox, public.chat_read_cursors, public.chat_pins, public.push_subscriptions,
     public.contacts, public.saved_rooms, public.account_notification_preferences, public.conversation_notification_preferences, public.attachments
  TO simplestchat_app;
GRANT SELECT, INSERT
  ON public.push_keys
  TO simplestchat_app;
GRANT SELECT, INSERT, DELETE
  ON public.invite_redemptions
  TO simplestchat_app;
COMMIT;
