[Unit]
Description=Expire retained public simplestChat browser assets

[Service]
Type=oneshot
RuntimeDirectory=simplestchat-bench
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 -B /usr/local/libexec/simplestchat-public/browser_assets.py prune
UMask=0077
TimeoutStartSec=30
MemoryMax=256M
TasksMax=32
CPUQuota=25%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/simplestchat-public/browser-assets /run/simplestchat-bench
RestrictSUIDSGID=true
LockPersonality=true
