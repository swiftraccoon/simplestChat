[Unit]
Description=Private simplestChat container benchmark (explicit invocation only)
Requires=docker.service
After=docker.service

[Service]
Type=exec
# Docker control is root-equivalent; application containers run as UID10001.
User=root
UMask=0077
RuntimeDirectory=simplestchat-bench
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/libexec/simplestchat-bench/run-benchmark
ExecStopPost=/usr/local/libexec/simplestchat-bench/cleanup-container-benchmark.sh
RuntimeMaxSec=900
TimeoutStopSec=90
KillMode=control-group
Restart=no
LimitCORE=0
StandardOutput=journal
StandardError=journal
