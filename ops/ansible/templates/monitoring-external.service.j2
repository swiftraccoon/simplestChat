[Unit]
Description=Import bounded public GitHub reliability evidence into private PostgreSQL
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/simplestchat-public/simplestchat-ops monitor external
UMask=0077
TimeoutStartSec=90
MemoryMax=128M
TasksMax=32
CPUQuota=20%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/simplestchat-monitoring
RestrictSUIDSGID=true
LockPersonality=true
