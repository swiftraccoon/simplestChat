+// limitLeafJob bounds actual jobs across matrix pools and reusable workflows.
+// The slot covers setup, steps, post actions and cleanup, including failures.
+func (runner *runnerImpl) limitLeafJob(reusable bool, executor common.Executor) common.Executor {
+	if reusable {
+		return executor
+	}
+	return func(ctx context.Context) error {
+		select {
+		case runner.config.jobSlots <- struct{}{}:
+			defer func() { <-runner.config.jobSlots }()
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+		return executor(ctx)
+	}
+}
