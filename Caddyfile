# SimplestChat reverse proxy. Set CADDY_DOMAIN and point its DNS record at this
# server. Caddy provisions and renews the TLS certificate. For the Compose
# proxy, set CADDY_UPSTREAM=simplestchat:3000; the default is a host-local backend.
{
	# Keep Caddy's loopback-only admin endpoint for reloads. Do not publish its
	# port from a container or override it with a publicly reachable address.
	servers {
		# Bound slow request setup and unused keep-alive connections. The idle
		# timeout applies between HTTP requests, not to upgraded WebSockets.
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$CADDY_DOMAIN:simplestchat.example.com} {
	# Operational endpoints stay private, even when enabled on the backend.
	# Reach the loopback backend directly with its bearer token instead.
	@private path /metrics /metrics/* /diagnostics /diagnostics/*
	respond @private "Not Found" 404

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	# Do not enable access logging: WebSocket URLs can contain credentials.
	encode zstd gzip
	reverse_proxy {$CADDY_UPSTREAM:127.0.0.1:3000} {
		# Authenticates this proxy across Docker's bridge. Caddy's header_up
		# replaces any client-supplied value. Set the same >=32-byte secret on
		# Caddy and the application; never write it into this file.
		header_up X-SimplestChat-Proxy {$TRUSTED_PROXY_SECRET}
	}
}
