# SimplestChat reverse proxy. Set CADDY_DOMAIN and point its DNS record at this
# server. Caddy provisions and renews the TLS certificate. For the Compose
# proxy, set CADDY_UPSTREAM=simplestchat:3000; the default is a host-local backend.
{
	# Keep Caddy's loopback-only admin endpoint for reloads. Do not publish its
	# port from a container or override it with a publicly reachable address.
	servers {
		# Bound slow request setup and unused keep-alive connections. The idle
		# timeout applies between HTTP requests, not to upgraded WebSockets.
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$CADDY_DOMAIN:simplestchat.example.com} {
	# Operational endpoints stay private, even when enabled on the backend.
	# Reach the loopback backend directly with its bearer token instead.
	@private path /metrics /metrics/* /diagnostics /diagnostics/*
	respond @private "Not Found" 404

	# Deleting Server defers this block, so a plain Set replaces whatever the
	# backend sent. The application owns the content security policy: it sends
	# this same policy by default and a tighter one where a handler serves
	# untrusted bytes (attachment downloads, room images). The ? prefix keeps
	# the proxy's copy as the default for responses the proxy answers itself.
	header {
		Strict-Transport-Security "max-age=31536000"
		?Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	# HTML must revalidate across upgrades and rollbacks, including older apps.
	# Match response headers so hashed assets and API cache policies are preserved.
	header Cache-Control "no-cache, no-store, must-revalidate" {
		match header Content-Type text/html*
	}

	# Do not enable access logging: WebSocket URLs can contain credentials.
	encode zstd gzip
	# Only validated public files can answer an upstream miss. This directory is
	# a readonly, bounded release store, independent of the selected app image.
	@retained_asset {
		method GET HEAD
		path_regexp retained ^/assets/[A-Za-z0-9_-]+-[A-Za-z0-9_-]{6,64}\.(js|css|woff2?|svg|png|jpe?g|webp|avif|ico)$
		file {
			root /run/simplestchat-browser-assets/public
			try_files {path}
		}
	}
	@retained_version {
		method GET HEAD
		path /app-version.json
		file {
			root /run/simplestchat-browser-assets/public
			try_files {path}
		}
	}
	reverse_proxy {$CADDY_UPSTREAM:127.0.0.1:3000} {
		# Authenticates this proxy across Docker's bridge. Caddy's header_up
		# replaces any client-supplied value. Set the same >=32-byte secret on
		# Caddy and the application; never write it into this file.
		header_up X-SimplestChat-Proxy {$TRUSTED_PROXY_SECRET}
		@missing status 404
		handle_response @missing {
			handle @retained_asset {
				root * /run/simplestchat-browser-assets/public
				header Cache-Control "public, max-age=60, immutable"
				file_server
			}
			handle @retained_version {
				root * /run/simplestchat-browser-assets/public
				header Cache-Control "no-store"
				file_server
			}
			handle {
				copy_response
			}
		}
	}
}
